APP_NAME=Nawy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nawy.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NAWY_BASE_DOMAIN=nawy.test
NAWY_COUNTRY_DB_PREFIX=nawy_
# WP11: old-platform snapshot, read-only (legacy:migrate / legacy:reconcile). Never the live DB.
DB_LEGACY_DATABASE=nawy_legacy_snapshot
LEGACY_STORAGE_ROOT=/var/www/marketplace/backend/storage/app
NAWY_OPS_ALERT_EMAIL=
# fake = deterministic FakeGateway (no keys); http = real gateway adapters
NAWY_PAYMENTS_DRIVER=fake
# Driver "fake" only: HMAC secret for fake gateway webhooks when a country has no webhook_secret credential (required, no default).
NAWY_FAKE_WEBHOOK_SECRET=
# SMS for the legacy phone-code first sign-in: `log` (development) — production needs an SMS provider account (owner key).
NAWY_SMS_DRIVER=log
# Push notifications: `log` (development) or `fcm` with the owner's Firebase project id and service-account JSON / path.
NAWY_PUSH_DRIVER=log
NAWY_FCM_PROJECT_ID=
NAWY_FCM_CREDENTIALS=
# Customer website origin (Next.js `website/`, `npm run dev` on port 3000): gateway
# return redirects, referral links and newsletter confirmation links point here.
NAWY_STOREFRONT_URL=http://localhost:3000
NAWY_TRAVEL_APP_RETURN_URL=nawytravel://promotions/return
# Exchange rates for PayPal in USD: manual | log | openexchangerates (needs the owner App ID)
NAWY_EXCHANGE_RATES_DRIVER=manual
NAWY_EXCHANGE_RATES_APP_ID=
# QC-044 domain mapping: DNS targets shown in Admin → Domains
NAWY_DOMAINS_STOREFRONT_TARGET=
NAWY_DOMAINS_BACKEND_TARGET=
# QC-073: extra browser origins allowed by CORS (comma-separated), e.g. Flutter web builds.
NAWY_CORS_ORIGINS=
NAWY_API_RATE_PER_MINUTE=600

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# D16: build-time Reverb settings for the panels' live dispatch board
# (laravel-echo + pusher-js). The board connects only with
# VITE_REVERB_ENABLED=true (and a key); otherwise it stays on reload.
VITE_REVERB_ENABLED=false
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Live streams (ADR 11). With NAWY_LIVE_MEDIA_DRIVER=livekit the API sets
# playback.webrtc=true and the website joins the room in the browser
# (livekit-client, D16); LIVEKIT_WS_URL must be reachable from browsers.
# LIVEKIT_HLS_URL_TEMPLATE gives the website an HLS
# playback URL for live rooms (egress / CDN), "{room}" = room name; leave it
# empty when there is no HLS egress (the API then returns hls_url null).
NAWY_LIVE_MEDIA_DRIVER=fake
LIVEKIT_URL=
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HLS_URL_TEMPLATE=

# D9 customer social sign-in ("fake" without provider keys; "live" with them)
NAWY_SOCIAL_AUTH_DRIVER=fake
# Customer app web sign-in (Google / Apple without the native SDKs) returns here.
NAWY_APP_SOCIAL_REDIRECT_URI=nawy://auth/social/complete
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_APP_CLIENT_IDS=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_APP_IDS=
