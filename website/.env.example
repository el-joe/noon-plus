# Laravel API root (the `/api/v1` prefix included). Used by server components
# and by the same-origin BFF proxy at /api/nawy/* that the browser talks to.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Market used when a visitor opens "/" without a preference cookie.
NEXT_PUBLIC_DEFAULT_MARKET=uae-en
# D16 realtime (laravel-echo + pusher-js): the Reverb app key (public) and
# where browsers reach Reverb. Leave the key empty to keep polling (live chat,
# notification bell, order updates). Read at build time.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
# Real-estate map view (D16 leaflet). Raster tile URL template ({s} {z} {x} {y};
# add a commercial provider's key in the URL), its attribution (HTML, required
# by every tile provider — a custom URL gets no default attribution) and the
# provider's max zoom. Empty = public OpenStreetMap tiles with the OSM credit
# (fine for low traffic; heavy use needs a commercial provider per the OSM tile
# usage policy). Read at build time.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=
